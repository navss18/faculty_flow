# Faculty Flow — Environment Configuration
# Copy this file to .env in your frontend directory and update with your Supabase project credentials.
# Note: In Vite, only variables prefixed with VITE_ are exposed to the client bundle.
# NEVER put service_role secret keys in this file or frontend code!

VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-public-key-here
